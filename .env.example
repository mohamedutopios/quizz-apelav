# =============================================================
# Variables d'environnement - Quiz APELAV
# Copier en .env et modifier AVANT le premier docker compose up
# =============================================================

# --- Sécurité (à changer obligatoirement) ---
# Génère un secret aléatoire :  openssl rand -base64 64
JWT_SECRET=CHANGE_ME_64chars_minimum_aQbR8XyZ_PleaseUseAnActualRandomSecret_123456
MYSQL_ROOT_PASSWORD=ChangeMeRootStrong!2026
DB_USER=apelav
DB_PASSWORD=ChangeMeDbStrong!2026
DB_NAME=apelav_quizz

# --- Admin par défaut ---
# Connectez-vous avec ADMIN_USERNAME / ADMIN_PASSWORD au 1er démarrage
ADMIN_USERNAME=admin&admin
ADMIN_PASSWORD=Apelav2026!ChangeMeASAP
ADMIN_NOM=Admin
ADMIN_PRENOM=Admin

# --- Quiz ---
QUIZ_DURATION_MS=600000      # 10 minutes
BCRYPT_COST=12

# --- CORS / URL publique ---
# En local : https://localhost
# En prod  : https://quiz.votre-domaine.fr
CORS_ORIGIN=https://localhost
